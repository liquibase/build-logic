#!/usr/bin/env bash
# fips-vm: a FIPS-mode AlmaLinux 9 VM on your laptop, set up like the one GitHub Actions jobs get.
#
#   fips-vm up               create the VM the first time (5 to 30 minutes), or start it
#   fips-vm shell            open a shell in the VM, in the current folder
#   fips-vm run CMD [ARGS]   run a command in the VM, in the current folder, for example: fips-vm run mvn verify
#                            Your LIQUIBASE_* environment variables go with it, for example LIQUIBASE_LICENSE_KEY.
#   fips-vm status           show whether FIPS mode is on
#   fips-vm docker-env       print the DOCKER_HOST line to use the VM's Docker from the laptop
#   fips-vm stop             stop the VM
#   fips-vm delete           delete the VM
#
# Needs Lima 2 (brew install lima). Your home folder is shared with the VM at the same path.
# FIPS_VM_CPUS and FIPS_VM_MEMORY (GiB) size the VM when it's created; the default is 4 CPUs and 8 GiB.
# Guide: https://datical.atlassian.net/wiki/spaces/TE/pages/5892636673
set -euo pipefail

name=${FIPS_VM_NAME:-fips}
# A Lima home of its own, so the VM gets an ECDSA SSH key: OpenSSH on RHEL 9 refuses Ed25519 keys in FIPS mode,
# and Lima's default key is Ed25519. Other Lima VMs on the laptop are not affected.
export LIMA_HOME=${FIPS_VM_LIMA_HOME:-$HOME/.fips-vm/lima}
source_url=${FIPS_VM_SOURCE_URL:-https://raw.githubusercontent.com/liquibase/build-logic/main/fips}
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

die() {
  echo "fips-vm: $*" >&2
  exit 1
}

command -v limactl >/dev/null || die "Lima 2 isn't installed. Install it with: brew install lima (macOS) or see https://lima-vm.io/docs/installation/ (Linux)"

# A file from build-logic/fips: next to this script when run from a checkout, otherwise from GitHub.
fetch() {
  if [ -f "$here/$1" ] && [ -z "${FIPS_VM_SOURCE_URL:-}" ]; then
    cat "$here/$1"
  else
    curl -fsSL "$source_url/$1"
  fi
}

# Lima's own messages: only warnings and errors.
lima() { limactl --log-level=warn "$@"; }
exists() { limactl list --format '{{.Name}}' 2>/dev/null | grep -qx "$name"; }
running() { [ "$(limactl list --format '{{.Status}}' "$name" 2>/dev/null)" = Running ]; }
need_running() { running || die "The FIPS VM isn't running. Start it with: fips-vm up"; }
in_vm() { limactl shell --workdir / "$name" "$@"; }

# Runs the provisioning in the VM, with its output in a log and a progress line every 20 seconds.
provision() {
  local log="$HOME/.fips-vm/provision.log" script="$HOME/.fips-vm/provision.sh" started=$SECONDS pid
  echo "==> Installing Docker, Java and Maven, and turning FIPS mode on (log: $log)"
  fetch provision.sh > "$script" || die "Couldn't download provision.sh from $source_url"
  in_vm sudo bash -s < "$script" > "$log" 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    sleep 20
    kill -0 "$pid" 2>/dev/null || break
    printf '    %2dm%02ds  %s\n' $(((SECONDS - started) / 60)) $(((SECONDS - started) % 60)) \
      "$(tr '\r' '\n' < "$log" | grep -v '^[[:space:]]*$' | tail -n 1 | cut -c1-100)"
  done
  if ! wait "$pid"; then
    tail -n 30 "$log"
    die "Installing the software in the VM failed. The full log is $log"
  fi
}

up() {
  if ! exists; then
    echo "==> Creating the FIPS VM '$name'. This takes 5 to 30 minutes, depending on how fast the AlmaLinux mirrors are."
    mkdir -p "$LIMA_HOME/_config"
    [ -f "$LIMA_HOME/_config/user" ] || ssh-keygen -q -t ecdsa -b 384 -N '' -C fips-vm -f "$LIMA_HOME/_config/user"
    template_dir=$(mktemp -d "${TMPDIR:-/tmp}/fips-vm.XXXXXX")
    trap 'rm -rf "$template_dir"' EXIT
    fetch lima.yaml > "$template_dir/fips.yaml"
    lima create --tty=false --name "$name" \
      ${FIPS_VM_CPUS:+--cpus="$FIPS_VM_CPUS"} ${FIPS_VM_MEMORY:+--memory="$FIPS_VM_MEMORY"} "$template_dir/fips.yaml"
  fi
  if ! running; then
    echo "==> Starting the FIPS VM"
    # The first start installs a few packages from the AlmaLinux mirrors, which can take longer than Lima's
    # default 10 minutes.
    lima start --tty=false --timeout=30m "$name"
  fi
  if [ "$(in_vm cat /proc/sys/crypto/fips_enabled)" != 1 ]; then
    provision
    # shellcheck disable=SC2016 # expanded in the VM
    in_vm sh -c 'sudo usermod -aG docker "$(id -un)"'
    echo "==> Restarting the VM in FIPS mode"
    lima stop "$name" >/dev/null 2>&1
    lima start --tty=false "$name"
    [ "$(in_vm cat /proc/sys/crypto/fips_enabled)" = 1 ] ||
      die "The VM didn't come back in FIPS mode. See $HOME/.fips-vm/provision.log, then try: fips-vm delete && fips-vm up"
  fi
  echo "==> Ready"
  status
}

status() {
  need_running
  # shellcheck disable=SC2016 # expanded in the VM
  in_vm sh -c 'echo "fips_enabled: $(cat /proc/sys/crypto/fips_enabled)"
    echo "$(sudo fips-mode-setup --check 2>&1 | tail -n 1)"
    echo "os: $(. /etc/os-release && echo "$PRETTY_NAME") ($(uname -m)), kernel $(uname -r)"
    echo "java: $(java -version 2>&1 | head -n 1)"
    echo "docker: $(docker --version)"'
}

case "${1:-}" in
  up) up ;;
  shell) need_running && limactl shell "$name" bash -l ;;
  run)
    shift
    [ $# -gt 0 ] || die "usage: fips-vm run CMD [ARGS]"
    need_running
    # Pass LIQUIBASE_* variables (license key, command arguments) to the VM; the rest of the laptop's
    # environment, like PATH or JAVA_HOME, doesn't apply there.
    liquibase_env=()
    while IFS= read -r var; do
      liquibase_env+=("$var=${!var}")
    done < <(compgen -e | grep '^LIQUIBASE_' || true)
    limactl shell "$name" env ${liquibase_env[@]+"${liquibase_env[@]}"} bash -lc '"$@"' fips-vm "$@"
    ;;
  status) status ;;
  docker-env)
    need_running
    echo "export DOCKER_HOST=unix://$(limactl list --format '{{.Dir}}' "$name")/sock/docker.sock"
    ;;
  stop)
    # Lima logs a harmless "use of closed network connection" error while it shuts the VM down.
    lima stop "$name" 2>&1 | { grep -v 'use of closed network connection' || true; }
    [ "${PIPESTATUS[0]}" = 0 ] && echo "==> Stopped"
    ;;
  delete) lima delete --force "$name" ;;
  *) sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' && exit 2 ;;
esac
